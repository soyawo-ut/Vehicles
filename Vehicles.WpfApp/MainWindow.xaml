<Window x:Class="Vehicles.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vehicles"
        Height="900"
        Width="950"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="160"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="230"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="15">

            <StackPanel>
                <TextBlock Text="Add vehicle"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <WrapPanel>
                    <TextBlock Text="Type:"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>

                    <ComboBox x:Name="VehicleTypeComboBox"
                              Width="150"
                              Margin="0,0,15,0">

                        <ComboBoxItem Content="Car"/>
                        <ComboBoxItem Content="Boat"/>
                        <ComboBoxItem Content="AmphibiousCar"/>

                    </ComboBox>

                    <TextBlock Text="Make:"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>

                    <TextBox x:Name="MakeTextBox"
                             Width="140"
                             Margin="0,0,15,0"/>

                    <TextBlock Text="Model:"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>

                    <TextBox x:Name="ModelTextBox"
                             Width="140"
                             Margin="0,0,15,0"/>

                    <Button Content="Add"
                            Width="90"
                            Click="AddVehicle_Click"/>
                </WrapPanel>

                <WrapPanel Margin="0,15,0,0">

                    <TextBlock Text="Distance:"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>

                    <TextBox x:Name="DistanceTextBox"
                             Width="100"
                             Text="10"/>

                    <TextBlock Text="km"
                               VerticalAlignment="Center"
                               Margin="5,0,0,0"/>

                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Padding="15">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Car garage"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <ListBox x:Name="CarGarageListBox"
                             Grid.Row="1"/>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0">

                        <Button Content="Move"
                                Width="100"
                                Margin="5"
                                Click="MoveCar_Click"/>

                        <Button Content="Remove selected"
                                Width="130"
                                Margin="5"
                                Click="RemoveCar_Click"/>

                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Padding="15">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Boat garage"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <ListBox x:Name="BoatGarageListBox"
                             Grid.Row="1"/>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0">

                        <Button Content="Move"
                                Width="100"
                                Margin="5"
                                Click="MoveBoat_Click"/>

                        <Button Content="Remove selected"
                                Width="130"
                                Margin="5"
                                Click="RemoveBoat_Click"/>

                    </StackPanel>
                </Grid>
            </Border>

        </Grid>

        <Border Grid.Row="4"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="10">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Activity log"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="LogTextBox"
                         Grid.Row="1"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"/>

            </Grid>
        </Border>

        <Border Grid.Row="6"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="10">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0">

                    <TextBlock Text="Garage work"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>

                    <Button x:Name="SequentialButton"
                            Content="Sequential"
                            Width="110"
                            Margin="0,0,8,0"
                            Click="Sequential_Click"/>

                    <Button x:Name="ParallelButton"
                            Content="Parallel"
                            Width="110"
                            Margin="0,0,8,0"
                            Click="Parallel_Click"/>

                    <Button x:Name="CancelButton"
                            Content="Tühista"
                            Width="90"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="Cancel_Click"/>

                    <Button x:Name="ClearReportButton"
                            Content="Clear report"
                            Width="100"
                            Click="ClearReport_Click"/>

                </WrapPanel>

                <StackPanel Grid.Row="1"
                            Margin="0,8,0,8">

                    <TextBlock x:Name="WorkStatusText"
                               Text="Add vehicles and choose a mode."/>

                    <ProgressBar x:Name="WorkProgressBar"
                                 Height="10"
                                 Margin="0,4,0,0"/>

                </StackPanel>

                <TextBox x:Name="ReportTextBox"
                         Grid.Row="2"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>

            </Grid>
        </Border>

    </Grid>
</Window>